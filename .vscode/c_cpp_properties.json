{
  "configurations": [
    {
      "name": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}/include"
      ],
      "compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
      "cStandard": "${default}",
      "cppStandard": "${default}",
      "intelliSenseMode": "windows-gcc-x64",
      "compilerArgs": [
        "-g",
        "-std=c++17",
        "-I./include",
        "-L./lib",
        "src/\\*.cpp",
        "src/glad.c",
        "-lglfw3dll",
        "-o",
        "${workspaceFolder}/myprogram.exe"
      ]
    }
  ],
  "version": 4
}